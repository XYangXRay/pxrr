#       polarization: []
#       configuration: ''
#       comment: ''
#       sample_detector_distance: {magnitude: 640.0, unit: mm, comment: GIXOS/GIXS detector}
#       roi_specular: {x: 0.33, y: 0.5, z: 0.0, unit: mm, comment: 'virtual xrr energy:
#           14400.0 eV, xrr detector distance: 1039.9 mm', definition: HWHM, configuration: rectangular
#           vxh, orientation_normal: beta}
#       roi_bkg_offspec: {magnitude: 1.0, unit: mm, comment: phi off, use: true}
#     data_files:
#     - file: '[''46392'' ''46394'' ''46396'' ''46398'' ''46400'']'
#     additional_files:
#     - '46393'
#     - '46395'
#     - '46397'
#     - '46399'
#     - '46401'
#     scheme: angle-dispersive
#     comment: ''
# reduction:
#   software: {name: '[Software(name=''pseudo_xrr'', version=None, platform=None, comment=None)]'}
#   corrections:
#   - pixel geometrical correction (solid angle)
#   - bin beta
#   - angle to Q space
#   - chamber background subtraction using 'additional_files'
#   - 'bulk scattering background subtraction: constant background from high-Qz average,
#     Qz >= 0.7 /angstrom'
#   - fit qxy dependence to obtain kappa
#   - qz = [0.1, 0.15, 0.35] /angstrom (row [4, 7, 18])
#   - qxy0 range = [0.04, 0.06, 0.1, 0.15, 0.318] /angstrom
#   - conversion from GIXOS diffuse scattering (I0 R*) to pseudo-reflectivity / structure
#     factor using GIXOS2R
#   - beta transmission correction
#   - I0 = 2.7e+11
#   - GIXOS diffuse scattering settings
#   - GIXOS phi = 1.178 deg (qxy0 = 0.15 /angstrom)
#   - delta_phi (HWHM) = 0.0486 deg
#   - delta_beta (HWHM) = 0.07322 deg
#   - reflectivity settings
#   - virtual xrr energy = 14400.0 eV
#   - virtual xrr detector distance = 1040 mm
#   - resolution = slit, [0.33, 0.5] mm
#   - background = phi offset, 1 mm
#   - sample settings
#   - Qc = 0.0218 /angstrom
#   - tension = 0.05 N/m
#   - temperature = 293 K
#   - kappa = 1.00 +/- 0.00 kBT
#   - amin = 5 angstrom
#   call: geometrical_corr(); binning_GIXOS_tt(); th2q(); GIXOS_background_corr(); GIXOS_qxy_dependence();
#     GIXOS2R(qxy0_select_idx=[0, 1, 2, 3], resolution_mode=1, resolution_HW=[0.33 0.5
#     ], bkg_mode=0, bkg_off=1.0, tension=0.05, temp=293, kappa=1, amin=5)
# data_set: 0
# columns:
# - {name: Qz, unit: 1/angstrom, physical_quantity: wavevector transfer}
# - {name: R, physical_quantity: '(pseudo)reflectivity, calculated from GIXOS diffuse
#     scattering (R=R*/r)'}
# - {error_of: R, error_type: uncertainty, value_is: sigma}
# - {error_of: Qz, error_type: resolution, value_is: sigma}
# - {name: Psi_R, physical_quantity: specular roughness factor}
# - {name: sigma_CW, unit: angstrom, physical_quantity: 'capillary wave roughness at
#     reflectivity resolution, sqrt(-ln(Psi_R)/Qz^2)'}
# - {name: r_reduced, physical_quantity: reduced r (r_reduced = Psi_DS/Psi_R)}
