#       polarization: []
#       configuration: ''
#       comment: ''
#       sample_detector_distance: {magnitude: 680.0, unit: mm, comment: GIXOS/GIXS detector}
#       roi_specular: {x: 0.33, y: 0.5, z: 0.0, unit: mm, comment: 'virtual xrr energy:
#           14400.000419124199 eV, xrr detector distance: 1039.9 mm', definition: HWHM,
#         configuration: rectangular vxh, orientation_normal: beta}
#       roi_bkg_offspec: {magnitude: 1.0, unit: mm, comment: phi off, use: true}
#     data_files:
#     - file: '[''51218'' ''51220'' ''51222'' ''51224'' ''51226'' ''51228'' ''51230'']'
